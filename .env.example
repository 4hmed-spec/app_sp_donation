# =============================================================================
# Modèle de configuration. Copier ce fichier en « .env » puis adapter.
#   PowerShell :  Copy-Item .env.example .env
# Le fichier .env n'est JAMAIS commité (il est dans .gitignore).
# =============================================================================

# --- Général ---------------------------------------------------------------
# True en développement, False en production (obligatoire !)
DEBUG=True
# Clé secrète : en prod, en générer une avec :
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=changez-moi-cle-de-developpement-uniquement
# Noms de domaine autorisés, séparés par des virgules.
# En dev, ajouter l'IP de votre PC pour tester depuis un téléphone (ex. 192.168.1.20)
ALLOWED_HOSTS=127.0.0.1,localhost
# En prod : https://dons.exemple.fr (avec https://)
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# URL publique du site : c'est elle qui est encodée dans les QR codes
SITE_URL=http://127.0.0.1:8000

# --- Base de données -------------------------------------------------------
# Développement (SQLite, rien à installer) :
DATABASE_URL=sqlite:///db.sqlite3
# Test / production (PostgreSQL) :
# DATABASE_URL=postgres://dons_spf:motdepasse@localhost:5432/dons_spf

# --- Emails ----------------------------------------------------------------
# Développement : les emails s'affichent dans le terminal
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Secours populaire <no-reply@exemple.fr>
# Production (SMTP Brevo ou Mailjet) :
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp-relay.brevo.com        (Mailjet : in-v3.mailjet.com)
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=

# --- Production uniquement -------------------------------------------------
# Redirection automatique HTTP -> HTTPS (laisser True en prod)
# SECURE_SSL_REDIRECT=True
